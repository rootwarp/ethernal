# Dockerfile.cross-validate
#
# Hermetic CI image for M1.7 FR-P1-G1 (GO-059) cross-validation lane.
# Bakes a pinned ethstaker-deposit-cli so that `go test -tags=cross_validate`
# can exec a real external authority (research/01, architecture §11.3).
#
# Base: minimal python:3.12-slim (per task guidance: python slim or distroless+python).
# Pin process: update the ==VER below on new stable releases; rebuild/push image
# once per bump; capture the image digest SHA-256; pin that digest (not mutable tag)
# in .github/workflows/cross-validate.yml .
#
# Version chosen: ethstaker-deposit-cli==1.3.0 (latest stable per research/01 + github
# releases as of 2026-06-07; v1.3.0 2026-04-30). Record here + in SECURITY.md .
# (Bump only after verifying compatibility with our generated deposit_data JSON.)
#
# The image build itself refuses (fails) if the installed binary's --version does not
# contain the "ethstaker" string. This enforces research/01 §R2 at image-construction
# time (prevents accidental use of the deprecated ethereum/staking-deposit-cli fork,
# which still installs via the same "deposit" name on PyPI but is unmaintained).
#
# Usage in CI (after image push to GHCR):
#   docker run --rm -v ... -e DEPOSIT_CLI_BIN=ethstaker-deposit-cli <image@sha> ...
# The test (M1.7-2) will read DEPOSIT_CLI_BIN (or PATH) and refuse inside the test
# if --version lacks "ethstaker" (belt + suspenders with this image-level check).
#
# Local verif (per task):
#   docker build -f Dockerfile.cross-validate -t cross-validate-test .
#   docker run --rm cross-validate-test ethstaker-deposit-cli --version
#   # must contain "ethstaker"; the build already asserted it.
#
# Split-watch note: core Dockerfile + refuse + docs + minimal workflow scaffolding
# completed; full image-build/push job + make proxy + test impl in follow-ups (M1.7-2/3).

FROM python:3.12-slim

# Install exactly the pinned version; --no-cache-dir for smaller/hermetic layer.
RUN pip install --no-cache-dir --disable-pip-version-check \
    ethstaker-deposit-cli==1.3.0

# Refuse non-ethstaker at *build time* (image will not be produced if wrong fork).
# Matches research/01 §R2 exactly: assert "ethstaker" in --version output.
# (The entrypoint script name after pip install of this package is ethstaker-deposit-cli.)
RUN set -eu; \
    v="$(ethstaker-deposit-cli --version 2>&1 || true)"; \
    printf 'Installed ethstaker-deposit-cli --version: %s\n' "$v"; \
    case "$v" in
        *ethstaker*|*EthStaker*) \
            printf 'ethstaker-deposit-cli confirmed (refuse check passed).\n' \
            ;;
        *) \
            printf 'ERROR: installed CLI --version does not contain "ethstaker" (got: %s). ' "$v"; \
            printf 'This is the deprecated ethereum/staking-deposit-cli fork (research/01 R2). Refusing to build image.\n'; \
            exit 1 \
            ;;
    esac

# Make the CLI the default entry for convenience (CI overrides via DEPOSIT_CLI_BIN or explicit).
# PATH will include /usr/local/bin where pip places the console script.
ENTRYPOINT ["ethstaker-deposit-cli"]
CMD ["--help"]
