# Ethereum Devnet Network Configuration
#
# Values track Ethereum mainnet wherever a local single-node devnet allows it.
# Anything that deliberately differs from mainnet is marked with its mainnet
# value in a trailing comment.
#
# Source of truth: 02-generate-genesis.sh feeds these to
# ethereum-genesis-generator, whose output overwrites the templates in config/.
# Keys not recognised by the generator are silently ignored, so only add knobs
# that appear in its defaults/defaults.env.

# Network Parameters
CHAIN_ID=1337          # mainnet: 1 (a devnet must not reuse mainnet's id)
NETWORK_ID=1337

# Consensus Parameters
# ---------------------------------------------------------------
# Slot duration. The generator's knob is SLOT_DURATION_MS; the older
# SECONDS_PER_SLOT name is derived from this for the CL config template.
SLOT_DURATION_MS=12000 # mainnet: 12000

# NOTE: SLOTS_PER_EPOCH is deliberately absent.
# It is a *preset* constant, not runtime configuration: it lives in
# consensus-specs presets/mainnet/phase0.yaml (32), never in configs/*.yaml,
# and clients bind it at compile time from PRESET_BASE (Lighthouse:
# `type SlotsPerEpoch = U32` on MainnetEthSpec). Setting it here or in
# config.yaml has no effect. With PRESET_BASE=mainnet an epoch is
# 32 slots x 12s = 6.4 minutes, exactly as on mainnet.

NUM_VALIDATORS=4096    # mainnet genesis: 16384 (4096 keeps 128 validators/slot)

# Timing
GENESIS_DELAY=30       # mainnet: 604800 (7 days); short so local startup is quick

# Execution Layer genesis
GENESIS_GASLIMIT=60000000   # mainnet block gas limit as of 2026

# Ports - Execution Layer
EL_HTTP_PORT=8545      # JSON-RPC HTTP
EL_WS_PORT=8546        # WebSocket
EL_AUTH_PORT=8551      # Engine API (authenticated)
EL_P2P_PORT=30303      # P2P networking

# Ports - Consensus Layer
CL_HTTP_PORT=5052      # Beacon API
CL_P2P_PORT=9000       # P2P networking
CL_METRICS_PORT=5054   # Metrics

# Docker Images
# Pinned rather than floating: a :master generator can emit config keys a
# released Lighthouse cannot parse. Lighthouse's own CI pins the generator for
# the same reason. Bump these together and re-run 08-cleanup.sh --data.
RETH_IMAGE="ghcr.io/paradigmxyz/reth:v2.5.0"
LIGHTHOUSE_IMAGE="sigp/lighthouse:v8.2.1"
GENESIS_GENERATOR_IMAGE="ethpandaops/ethereum-genesis-generator:6.2.0"
ETH2_VAL_TOOLS_IMAGE="protolambda/eth2-val-tools:latest"

# Deposit contract
# Using mainnet's address keeps tooling that hardcodes it working unchanged.
DEPOSIT_CONTRACT_ADDRESS="0x00000000219ab540356cBB839Cbe05303d7705Fa"

# Pre-funded Account (for development)
# Private key: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# This is a well-known development key - DO NOT use in production
DEV_ACCOUNT="0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"

# Validator mnemonic for key generation (for development only)
# Account 0 of this mnemonic is DEV_ACCOUNT above.
# DO NOT use in production
VALIDATOR_MNEMONIC="test test test test test test test test test test test junk"
